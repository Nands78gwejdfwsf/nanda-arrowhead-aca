{
  "applications": {
    "pureota": {
      "displayName": "PureOTA",
      "enabled": true,
      "containerAppName": "nanda-ca-pureota",
      "imageName": "pureota",
      "buildContext": "apps/pureota",
      "dockerfile": "apps/pureota/Dockerfile",
      "targetPort": 80,
      "healthPath": "/healthz",
      "minReplicas": 1,
      "maxReplicas": 1,
      "ingress": {
        "external": true,
        "transport": "auto"
      },
      "identity": {
        "name": "NANDA-id-pureota"
      },
      "entra": {
        "groupName": "NANDA-PureOTA-Users",
        "applicationName": "NANDA-PureOTA-ACA-Test",
        "redirectPath": "/.auth/login/aad/callback"
      },
      "keyVault": {
        "authSecretName": "pureota-entra-client-secret",
        "storageKeySecretName": "pureota-storage-key",
        "readAuthSecret": true,
        "readStorageKeySecret": true
      },
      "postgres": {
        "enabled": true,
        "databaseName": "arrowhead",
        "schemaName": "pureota"
      },
      "storage": {
        "enabled": true,
        "accountName": "nandastarrowheadaca",
        "fileShareName": "pureota-data",
        "bindingName": "nanda-pureota-storage",
        "mountPath": "/usr/share/nginx/html/tier-data",
        "privateEndpointName": "NANDA-pe-pureota-storage",
        "privateDnsLinkName": "NANDA-link-pureota-storage-private-dns",
        "privateDnsZoneGroupName": "storage-file-dns-zone-group",
        "backupPolicyName": "NANDA-afs-daily-30d"
      },
      "job": {
        "enabled": true,
        "jobName": "nanda-job-pureota",
        "command": "/usr/local/bin/db-check.sh && echo \"PureOTA dummy ACA Job executed\" > /mnt/tier-data/job-validation.txt && date -u >> /mnt/tier-data/job-validation.txt && cat /mnt/tier-data/job-validation.txt"
      }
    },
    "helixbridge": {
      "displayName": "HelixBridge",
      "enabled": true,
      "containerAppName": "nanda-ca-helixbridge",
      "imageName": "helixbridge",
      "buildContext": "apps/helixbridge",
      "dockerfile": "apps/helixbridge/Dockerfile",
      "targetPort": 80,
      "healthPath": "/healthz",
      "minReplicas": 1,
      "maxReplicas": 1,
      "ingress": {
        "external": true,
        "transport": "auto"
      },
      "identity": {
        "name": "NANDA-id-helixbridge"
      },
      "entra": {
        "groupName": "NANDA-HelixBridge-Users",
        "applicationName": "NANDA-HelixBridge-ACA-Test",
        "redirectPath": "/.auth/login/aad/callback"
      },
      "keyVault": {
        "authSecretName": "helixbridge-entra-client-secret",
        "storageKeySecretName": "",
        "readAuthSecret": true,
        "readStorageKeySecret": false
      },
      "postgres": {
        "enabled": true,
        "databaseName": "arrowhead",
        "schemaName": "helixbridge"
      },
      "storage": {
        "enabled": false,
        "accountName": "",
        "fileShareName": "",
        "bindingName": "",
        "mountPath": "",
        "privateEndpointName": "",
        "privateDnsLinkName": "",
        "privateDnsZoneGroupName": "",
        "backupPolicyName": ""
      },
      "job": {
        "enabled": false,
        "jobName": "",
        "command": ""
      }
    },
    "gowda": {
      "displayName": "Gowda",
      "enabled": true,
      "containerAppName": "nanda-ca-gowda",
      "imageName": "gowda",
      "buildContext": "apps/gowda",
      "dockerfile": "apps/gowda/Dockerfile",
      "targetPort": 80,
      "healthPath": "/healthz",
      "minReplicas": 1,
      "maxReplicas": 2,
      "ingress": {
        "external": true,
        "transport": "auto"
      },
      "identity": {
        "name": "NANDA-id-gowda"
      },
      "entra": {
        "groupName": "NANDA-Gowda-Users",
        "applicationName": "NANDA-Gowda-ACA-Test",
        "redirectPath": "/.auth/login/aad/callback"
      },
      "keyVault": {
        "authSecretName": "gowda-entra-client-secret",
        "storageKeySecretName": "gowda-storage-key",
        "readAuthSecret": true,
        "readStorageKeySecret": true
      },
      "postgres": {
        "enabled": true,
        "databaseName": "arrowhead",
        "schemaName": "gowda"
      },
      "storage": {
        "enabled": true,
        "accountName": "nandastarrowheadaca",
        "fileShareName": "gowda-data",
        "bindingName": "nanda-gowda-storage",
        "mountPath": "/usr/share/nginx/html/tier-data",
        "privateEndpointName": "NANDA-pe-gowda-storage",
        "privateDnsLinkName": "NANDA-link-gowda-storage-private-dns",
        "privateDnsZoneGroupName": "storage-file-dns-zone-group",
        "backupPolicyName": "NANDA-afs-daily-30d"
      },
      "job": {
        "enabled": true,
        "jobName": "nanda-job-gowda",
        "command": "/usr/local/bin/db-check.sh && echo \"Gowda dummy ACA Job executed\" > /mnt/tier-data/job-validation.txt && date -u >> /mnt/tier-data/job-validation.txt && cat /mnt/tier-data/job-validation.txt"
      }
    }
  }
}